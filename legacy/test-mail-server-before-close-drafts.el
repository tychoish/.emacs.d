(ert-deftest tychoish-mail-server/failed-pong-does-not-mark-ready ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (mu4e-pong-func nil)
          (running t)
          (pongs 0))
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil)))
                ((symbol-function 'mu4e)
                 (lambda (&rest _)
                   (setq running t mu4e-pong-func
                         (lambda (_) (setq mu4e--started t) (error "bad pong")))))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _)
                   (setq pongs (1+ pongs))
                   ;; Process filters report errors without returning them to the waiter.
                   (condition-case nil (funcall mu4e-pong-func nil) (error nil)))))
        (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
        (should (> pongs 0))
        (should-not running)
        (should-not tychoish-mail--server-home)
        (should (equal mu4e-mu-home "/tmp/mail-a/.mu"))))))

(ert-deftest tychoish-mail-server/start-timeout-cleans-up ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (mu4e-pong-func nil)
          (running t)
          (clock 0))
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil)))
                ((symbol-function 'mu4e)
                 (lambda (&rest _) (setq running t mu4e-pong-func #'ignore)))
                ((symbol-function 'float-time) (lambda (&rest _) (cl-incf clock)))
                ((symbol-function 'accept-process-output) #'ignore))
        (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
        (should (>= clock 10))
        (should-not running)
        (should-not tychoish-mail--server-home)
        (should (equal mu4e-mu-home "/tmp/mail-a/.mu"))))))

(ert-deftest tychoish-mail-server/failed-cleanup-records-running-home ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (running t)
          (stops 0))
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit)
                 (lambda (&rest _)
                   (if (= (cl-incf stops) 1)
                       (setq running nil)
                     (error "cleanup failed"))))
                ((symbol-function 'mu4e)
                 (lambda (&rest _) (setq running t) (error "startup failed"))))
        (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
        (should (= stops 2))
        (should running)
        (should (equal tychoish-mail--server-home "/tmp/mail-b/.mu"))
        (should (equal mu4e-mu-home "/tmp/mail-b/.mu"))))))

(provide 'test-mail-server)
