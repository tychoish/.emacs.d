;;; test-mail-server.el --- Mu server lifecycle regression tests -*- lexical-binding: t; -*-

;;; Commentary:
;; Isolated tests for server startup, shutdown, and database transitions.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'tychoish-mail-server)
(require 'mu4e)

(defmacro tychoish-mail-server-test--isolated (&rest body)
  "Evaluate BODY without retaining a live session's server state."
  (declare (indent 0) (debug t))
  `(let ((mu4e--server-process nil)
         (tychoish-mail--stopping-process nil))
     ,@body))

(ert-deftest tychoish-mail-server/initial-start-records-server-home ()
  (let ((tychoish-mail--server-home nil)
        (mu4e-mu-home "/tmp/mail-a/.mu"))
    (should (advice-member-p #'tychoish-mail--record-server-home 'mu4e--server-start))
    (cl-letf (((symbol-function 'mu4e-running-p) (lambda () nil)))
      (tychoish-mail--record-server-home)
      (should-not tychoish-mail--server-home))
    (cl-letf (((symbol-function 'mu4e-running-p) (lambda () t)))
      (tychoish-mail--record-server-home)
      (should (equal tychoish-mail--server-home "/tmp/mail-a/.mu")))))

(ert-deftest tychoish-mail-server/same-home-does-not-restart ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-b/.mu")
          (mu4e-mu-home "/tmp/mail-b/.mu")
          (mu4e--started t)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          stopped started)
      (cl-letf (((symbol-function 'mu4e-running-p) (lambda () t))
                ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq stopped t)))
                ((symbol-function 'mu4e) (lambda (&rest _) (setq started t))))
        (tychoish-mail-server-switch-database "/tmp/mail-b/.mu")
        (should-not stopped)
        (should-not started)))))

(ert-deftest tychoish-mail-server/update-blocks-transition ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started t)
          (mu4e--server-indexing t)
          (mu4e--update-buffer nil)
          stopped)
      (cl-letf (((symbol-function 'mu4e-running-p) (lambda () t))
                ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq stopped t))))
        (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu") :type 'user-error)
        (should-not stopped)
        (should (equal tychoish-mail--server-home "/tmp/mail-a/.mu"))))))

(ert-deftest tychoish-mail-server/fetch-blocks-transition-with-server-stopped ()
  (tychoish-mail-server-test--isolated
    (with-temp-buffer
      (let ((mu4e-mu-home "/tmp/mail-a/.mu")
            (mu4e--server-indexing nil)
            (mu4e--update-buffer (current-buffer)))
        (cl-letf (((symbol-function 'mu4e-running-p) (lambda () nil))
                  ((symbol-function 'get-buffer-process) (lambda (_) 'fake))
                  ((symbol-function 'process-live-p) (lambda (_) t)))
          (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu")
                        :type 'user-error)
          (should (equal mu4e-mu-home "/tmp/mail-a/.mu")))))))

(ert-deftest tychoish-mail-server/start-failure-does-not-claim-active-home ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (mu4e-pong-func nil)
          (running t))
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil)))
                ((symbol-function 'mu4e) (lambda (&rest _) (error "startup failed"))))
        (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
        (should-not tychoish-mail--server-home)
        (should (equal mu4e-mu-home "/tmp/mail-a/.mu"))))))

(ert-deftest tychoish-mail-server/switch-waits-for-server-readiness ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (mu4e-pong-func nil)
          (running t)
          events)
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit)
                 (lambda (&rest _) (push 'stop events) (setq running nil)))
                ((symbol-function 'mu4e)
                 (lambda (&rest _)
                   (push (list 'start mu4e-mu-home) events)
                   (setq running t mu4e-pong-func (lambda (_info) t))))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _)
                   (should-not tychoish-mail--server-home)
                   (push 'ready events)
                   (setq mu4e--started t)
                   (funcall mu4e-pong-func nil))))
        (tychoish-mail-server-switch-database "/tmp/mail-b/.mu")
        (should (equal (nreverse events)
                       '(stop (start "/tmp/mail-b/.mu") ready)))
        (should (equal tychoish-mail--server-home "/tmp/mail-b/.mu"))))))

(ert-deftest tychoish-mail-server/switch-waits-for-old-process-exit ()
  (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
        (tychoish-mail--stopping-process nil)
        (mu4e-mu-home "/tmp/mail-a/.mu")
        (mu4e--server-process 'old-process)
        (mu4e--server-indexing nil)
        (mu4e--update-buffer nil)
        (mu4e--started t)
        (running t)
        (alive t)
        events)
    (cl-letf (((symbol-function 'mu4e-running-p) (lambda () running))
              ((symbol-function 'mu4e-quit)
               (lambda (&rest _) (push 'stop events) (setq running nil mu4e--server-process nil)))
              ((symbol-function 'process-live-p) (lambda (process) (and (eq process 'old-process) alive)))
              ((symbol-function 'accept-process-output)
               (lambda (&rest _) (push 'exit events) (setq alive nil)))
              ((symbol-function 'tychoish-mail-server-ensure-ready)
               (lambda () (push 'start events) (setq running t))))
      (tychoish-mail-server-switch-database "/tmp/mail-b/.mu")
      (should (equal (nreverse events) '(stop exit start)))
      (should-not tychoish-mail--stopping-process)
      (should (equal mu4e-mu-home "/tmp/mail-b/.mu")))))

(ert-deftest tychoish-mail-server/shutdown-timeout-blocks-retry-until-exit ()
  (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
        (tychoish-mail--stopping-process nil)
        (mu4e-mu-home "/tmp/mail-a/.mu")
        (mu4e--server-process 'old-process)
        (mu4e--server-indexing nil)
        (mu4e--update-buffer nil)
        (mu4e--started t)
        (running t)
        (alive t)
        (clock 0)
        started)
    (cl-letf (((symbol-function 'mu4e-running-p) (lambda () running))
              ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil mu4e--server-process nil)))
              ((symbol-function 'process-live-p) (lambda (_) alive))
              ((symbol-function 'float-time) (lambda (&rest _) (cl-incf clock)))
              ((symbol-function 'accept-process-output) #'ignore)
              ((symbol-function 'tychoish-mail-server-ensure-ready) (lambda () (setq started t))))
      (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
      (should-not started)
      (should (equal mu4e-mu-home "/tmp/mail-a/.mu"))
      (should (eq tychoish-mail--stopping-process 'old-process))
      (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
      (should-not started)
      (setq alive nil)
      (tychoish-mail-server-switch-database "/tmp/mail-b/.mu")
      (should-not tychoish-mail--stopping-process)
      (should (equal mu4e-mu-home "/tmp/mail-b/.mu")))))

(ert-deftest tychoish-mail-server/server-start-checks-pending-shutdown ()
  (should (advice-member-p #'tychoish-mail--await-stopped-server 'mu4e--server-start))
  (let ((tychoish-mail--stopping-process 'old-process)
        (clock 0))
    (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'float-time) (lambda (&rest _) (cl-incf clock)))
              ((symbol-function 'accept-process-output) #'ignore))
      (should-error (tychoish-mail--await-stopped-server))
      (should (eq tychoish-mail--stopping-process 'old-process)))))

(ert-deftest tychoish-mail-server/interrupted-shutdown-blocks-restart ()
  (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
        (tychoish-mail--stopping-process nil)
        (mu4e-mu-home "/tmp/mail-a/.mu")
        (mu4e--server-process 'old-process)
        (mu4e--server-indexing nil)
        (mu4e--update-buffer nil)
        (running t))
    (cl-letf (((symbol-function 'mu4e-running-p) (lambda () running))
              ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil mu4e--server-process nil)))
              ((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'accept-process-output) (lambda (&rest _) (signal 'quit nil))))
      (should (eq (condition-case nil
                      (progn (tychoish-mail-server-switch-database "/tmp/mail-b/.mu") nil)
                    (quit 'quit))
                  'quit))
      (should (eq tychoish-mail--stopping-process 'old-process))
      (should (equal mu4e-mu-home "/tmp/mail-a/.mu")))))

(ert-deftest tychoish-mail-server/failed-start-cleanup-retains-detached-server ()
  (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
        (tychoish-mail--stopping-process nil)
        (mu4e-mu-home "/tmp/mail-a/.mu")
        (mu4e--server-process 'old-process)
        (mu4e--server-indexing nil)
        (mu4e--update-buffer nil)
        (running t)
        (clock 0))
    (cl-letf (((symbol-function 'mu4e-running-p) (lambda () running))
              ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil mu4e--server-process nil)))
              ((symbol-function 'process-live-p) (lambda (process) (eq process 'new-process)))
              ((symbol-function 'float-time) (lambda (&rest _) (cl-incf clock)))
              ((symbol-function 'accept-process-output) #'ignore)
              ((symbol-function 'tychoish-mail-server-ensure-ready)
               (lambda () (setq running t mu4e--server-process 'new-process) (error "startup failed"))))
      (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
      (should (eq tychoish-mail--stopping-process 'new-process))
      (should-not tychoish-mail--server-home)
      (should (equal mu4e-mu-home "/tmp/mail-a/.mu"))
      (should-error (tychoish-mail--await-stopped-server)))))

(ert-deftest tychoish-mail-server/stop-failure-preserves-home ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          started)
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () t))
                ((symbol-function 'mu4e-quit) #'ignore)
                ((symbol-function 'mu4e) (lambda (&rest _) (setq started t))))
        (should-error (tychoish-mail-server-switch-database "/tmp/mail-b/.mu"))
        (should-not started)
        (should (equal tychoish-mail--server-home "/tmp/mail-a/.mu"))
        (should (equal mu4e-mu-home "/tmp/mail-a/.mu"))))))

(ert-deftest tychoish-mail-server/quit-during-start-cleans-up ()
  (tychoish-mail-server-test--isolated
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (mu4e-pong-func nil)
          (running t))
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil)))
                ((symbol-function 'mu4e)
                 (lambda (&rest _)
