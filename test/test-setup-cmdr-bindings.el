(ert-deftest setup-cmdr-test/migrated-personal-bindings ()
  (let ((cmdr-mode-map (make-sparse-keymap)))
    (setup-cmdr-install-bindings)
    (seq-do (lambda (binding)
              (should (eq (keymap-lookup cmdr-mode-map (car binding)) (cdr binding))))
            setup-cmdr-test-personal-bindings)))

(provide 'test-setup-cmdr-bindings)
