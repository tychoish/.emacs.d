(ert-deftest tychoish-mail-context/personal-selection-and-bindings ()
  "The personal configuration selects the expected context and commands."
  (let* ((file (expand-file-name "user/personal.el" test-helper-root))
         (mu4e-contexts nil)
         (mu4e--context-current nil)
         (cmdr-mode-map (make-sparse-keymap))
         (personal-mail-activation-timer nil)
         selected config)
    (skip-unless (file-readable-p file))
    (with-temp-buffer
      (insert-file-contents file)
      (condition-case nil
          (while t
            (let ((form (read (current-buffer))))
              (when (and (consp form)
                         (equal (seq-take form 2) '(with-eval-after-load 'setup-mail)))
                (setq config form))))
        (end-of-file nil)))
    (should config)
    (cl-letf (((symbol-function 'personal-mail-ensure-context) #'ignore)
              ((symbol-function 'tychoish-mail-kleinman) #'ignore)
              ((symbol-function 'tychoish-mail-sam) #'ignore)
              ((symbol-function 'tychoish-mail-tychoish) #'ignore)
              ((symbol-function 'tychoish-mail-work) #'ignore)
              ((symbol-function 'advice-add) #'ignore)
              ((symbol-function 'run-with-idle-timer) #'ignore)
              ((symbol-function 'tychoish-mail-add-refile-rule) #'ignore)
              ((symbol-function 'tychoish-mail-switch-context)
               (lambda (name) (setq selected name))))
      (eval `(progn ,@(cddr config)) t)
      (should (= (length mu4e-contexts) 4))
      (dolist (case '(("derrida" "work" "tychoish-mail-kleinman")
                      ("derrida" "tychoish" "tychoish-mail-sam")
                      ("derrida" "hud" "tychoish-mail-tychoish")
                      ("derrida" "other" "tychoish-mail-work")
                      ("unknown" "work" "tychoish-mail-work")))
        (cl-letf (((symbol-function 'system-name) (lambda () (nth 0 case)))
                  ((symbol-function 'sprite-instance-name) (lambda () (nth 1 case))))
          (setq selected nil)
          (personal-mail-ensure-context)
          (should (equal selected (nth 2 case)))))
      (dolist (binding '(("k" . tychoish-mail-kleinman)
                         ("s" . tychoish-mail-sam)
                         ("g" . tychoish-mail-tychoish)
                         ("w" . tychoish-mail-work)))
        (should (eq (keymap-lookup cmdr-mode-map (concat "C-c m " (car binding)))
                    (cdr binding)))
        (funcall (cdr binding))
        (should (equal selected (symbol-name (cdr binding))))))))

(provide 'test-mail-context)
