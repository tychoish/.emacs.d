(ert-deftest tychoish-mail-context/native-switch-refuses-other-open-draft ()
  (tychoish-mail-test--with-accounts
    (let ((draft (generate-new-buffer " *mail-context-draft*"))
          (mu4e--context-current (car mu4e-contexts))
          (mu4e-mu-home "/tmp/mail-b/.mu")
          (tychoish-mail--server-home "/tmp/mail-b/.mu")
          selected)
      (unwind-protect
          (progn
            (with-current-buffer draft (setq major-mode 'mu4e-compose-mode))
            (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) (list draft)))
                      ((symbol-function 'pop-to-buffer) (lambda (buf &rest _) (setq selected buf)))
                      ((symbol-function 'tychoish-mail--switch-database) #'ignore))
              (should-error (mu4e-context-switch nil "b") :type 'user-error)
              (should (eq selected draft))
              (should (eq mu4e--context-current (car mu4e-contexts)))))
        (kill-buffer draft)))))

