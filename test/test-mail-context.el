(ert-deftest tychoish-mail-context/failed-pong-does-not-mark-ready ()
  (tychoish-mail-test--with-accounts
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (mu4e-pong-func nil)
          (running t)
          (pongs 0))
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit) (lambda (&rest _) (setq running nil)))
                ((symbol-function 'mu4e)
                 (lambda (&rest _)
                   (setq running t mu4e-pong-func
                         (lambda (_) (setq mu4e--started t) (error "bad pong")))))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _)
                   (setq pongs (1+ pongs))
                   ;; Process filters report errors without returning them to the waiter.
                   (condition-case nil (funcall mu4e-pong-func nil) (error nil)))))
        (should-error (tychoish-mail--switch-database "/tmp/mail-b/.mu"))
        (should (> pongs 0))
        (should-not running)
        (should-not tychoish-mail--server-home)
        (should (equal mu4e-mu-home "/tmp/mail-a/.mu"))))))

