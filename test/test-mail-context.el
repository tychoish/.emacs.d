(ert-deftest tychoish-mail-context/switch-waits-for-server-readiness ()
  (tychoish-mail-test--with-accounts
    (let ((tychoish-mail--server-home "/tmp/mail-a/.mu")
          (mu4e-mu-home "/tmp/mail-a/.mu")
          (mu4e--started nil)
          (mu4e--server-indexing nil)
          (mu4e--update-buffer nil)
          (mu4e-compose-parent-message nil)
          (mu4e-pong-func nil)
          (running t)
          events)
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
                ((symbol-function 'mu4e-running-p) (lambda () running))
                ((symbol-function 'mu4e-quit)
                 (lambda (&rest _) (push 'stop events) (setq running nil)))
                ((symbol-function 'mu4e)
                 (lambda (&rest _)
                   (push (list 'start mu4e-mu-home) events)
                   (setq running t mu4e-pong-func (lambda (_info) t))))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _)
                   (should-not tychoish-mail--server-home)
                   (push 'ready events)
                   (setq mu4e--started t)
                   (funcall mu4e-pong-func nil))))
        (tychoish-mail--switch-database "/tmp/mail-b/.mu")
        (should (equal (nreverse events)
                       '(stop (start "/tmp/mail-b/.mu") ready)))
        (should (equal tychoish-mail--server-home "/tmp/mail-b/.mu"))))))

