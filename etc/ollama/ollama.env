# Ollama systemd --user environment configuration
# Target deployment path: ~/.config/ollama/env

# Host binding address
# Server (derrida): OLLAMA_HOST=0.0.0.0:11434
# Laptop (local):   OLLAMA_HOST=127.0.0.1:11434
OLLAMA_HOST=0.0.0.0:11434

# Model storage directory (default: ~/.ollama/models)
# OLLAMA_MODELS=%h/.ollama/models

# Keep-alive timeout for idle models (default: 5m, set to -1 to keep loaded indefinitely)
OLLAMA_KEEP_ALIVE=5m

# Cross-origin request handling
OLLAMA_ORIGINS=*
